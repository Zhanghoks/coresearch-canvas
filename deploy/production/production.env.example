# 复制到服务器 /srv/coresearch/env/production.env，chmod 600，owner 为 coresearch。
# 这个文件是生产密钥的唯一存放处：不进 Git、不进镜像、不进 docker-compose.yml、不进 GitHub Secrets。
# 改完之后重新跑一次 deploy.sh（或 docker compose up -d）才会生效。

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key

# 逗号分隔的精确来源，CORS 白名单。agent-api/src/app.ts 做的是精确字符串匹配：
# 不支持通配符、不能有空格、不能带路径或结尾斜杠。
# Vercel Preview 需要联调登录时，把对应 preview 域名追加进来并重新部署。
AGENT_API_ORIGINS=https://coresearch.xxx.com

PI_PROVIDER=openai
PI_MODEL=gpt-5.6
PI_API_KEY=your-platform-model-key
PI_AGENT_DIR=/var/lib/research-canvas/pi
PORT=4100

# 不要设置 ENABLE_BUILTIN_TEST_ACCOUNT。
# 设了之后每次容器启动都会把内置 test 账号密码重置为 12345678，自动化部署下这会每天发生多次。

# 默认运行时是 pi。不要在生产设置 AGENT_RUNTIME=codex：
# 当前镜像里没有安装 codex 二进制，且 002_codex_runtime.sql 需要先手工执行。
