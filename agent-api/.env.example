SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
AGENT_API_ORIGINS=http://localhost:3000
PI_PROVIDER=openai
PI_MODEL=gpt-5.6
PI_API_KEY=your-platform-model-key
PI_AGENT_DIR=/var/lib/research-canvas/pi
PORT=4100
# 内置 test 账号（test / 12345678）。每次启动都会把密码重置回固定值，只供 CI 和本地验收使用。
# 生产环境不要设置这个变量；npm run acceptance:live 需要它。
ENABLE_BUILTIN_TEST_ACCOUNT=1

# Codex 托管运行时（AGENT_RUNTIME=codex 时才需要；默认仍是 pi）
# AGENT_RUNTIME=codex
# CODEX_BIN=codex
# CODEX_API_KEY=your-platform-codex-key
# AGENT_RUNTIME_ROOT=/srv/coresearch/runtime
# AGENT_RUNTIME_TOKEN_SECRET=replace-with-a-long-random-string

