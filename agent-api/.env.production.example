# 复制为 agent-api/.env 后填写。不要提交 .env，不要使用 VITE_ 前缀。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
# 逗号分隔。生产域必填；Vercel Preview 和备用 Web 域需要登录 Agent 时再追加。
AGENT_API_ORIGINS=https://coresearch.xxx.com
PI_PROVIDER=openai
PI_MODEL=gpt-5.6
PI_API_KEY=your-platform-model-key
PI_AGENT_DIR=/var/lib/research-canvas/pi
PORT=4100

# 默认运行时是 pi，不要设置 AGENT_RUNTIME=codex。
